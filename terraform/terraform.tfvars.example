project_id = "<your-gcp-project-id>"
region = "us-central1"
bucket_name = "<gcs-bucket-name>"
bucket_location = "US"
service_account_id = "digital-twin-backend"
service_account_display_name = "Digital Twin Backend"
credentials_file = ""
backend_key_output_path = "./backend-sa-key.json"

turnstile_site_key = "<public-turnstile-site-key>"

# image_tag is only used when the Cloud Run service is first created (default
# "latest"); afterwards the deploy-on-master Cloud Build trigger rolls out new
# images on every push to master. Don't set it here.
