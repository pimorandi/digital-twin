HISTORY_GCS_URI=gs://<bucket>/<path>.md
HISTORY_LOCAL_PATH=
VITE_API_URL=/api
FRONTEND_PORT=3000
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=3600
GCP_PROJECT_ID=<your-gcp-project-id>
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
MAX_HISTORY_PAIRS=10
CHAT_LOG_GCS_URI=gs://<bucket>/chat-logs/

# Bot protection (Cloudflare Turnstile + signed session token).
# Local/dev: Cloudflare's always-pass TEST keys. Never use them in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Any long random string, e.g. `openssl rand -base64 32`
SESSION_SIGNING_KEY=
MAX_MESSAGES_PER_SESSION=30
MAX_OUTPUT_TOKENS=1024
