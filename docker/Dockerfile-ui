# Build context is the repo root (see compose.prod.yaml) so this stage can also
# pull in docker/nginx.conf without reaching outside the build context.

# --- build stage ---
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
# Baked into the JS bundle at build time (Vite convention). Defaults to /api per
# docs/architecture.md's single-entry-point design: nginx is the only public
# origin, so the frontend must call a same-origin relative path, never a Docker
# service hostname like http://backend:8000 (that only resolves container-to-
# container, not from the browser this bundle runs in).
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# --- serve stage ---
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Templated (not a static conf.d file) so the same image can target either
# Compose's service-name DNS or Cloud Run's sidecar localhost networking via
# the BACKEND_UPSTREAM runtime env var — see docker/nginx.conf.template.
# nginx's official image envsubst's *.template files here into /etc/nginx/conf.d/
# at container start.
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
